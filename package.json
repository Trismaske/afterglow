{
  "name": "afterglow",
  "version": "0.0.0",
  "private": true,
  "description": "Ambient photo display (desktop) + photo culling companion (Android), sharing one brain.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "setup:android": "bash scripts/setup-android-env.sh",
    "emulator": "bash scripts/run-emulator.sh",
    "mobile:android": "npm run android:run -w afterglow-companion",
    "mobile:start": "npm run start -w afterglow-companion"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.66.0"
  }
}
